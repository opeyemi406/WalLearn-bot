# ==============================================================================
# WalLearn Configuration Template (.env)
# Plug-and-play template for Hackathon Judges & Independent Auditors
# ==============================================================================

# 1. Telegram Bot Token (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=

# 2. AI Model Gateway (OpenRouter API Key)
OPENROUTER_API_KEY=
AI_MODEL=google/gemini-2.5-flash

# 3. Walrus Protocol MemWal Credentials
# Provide your own MemWal credentials using ONE of the following methods:
#
# IMPORTANT: All credentials (accountId, walletAddress, delegateAddress, delegatePrivateKey)
# MUST belong to the SAME Sui / MemWal account. Never mix a private key with another account ID.

# Option A: Local credentials directory containing credentials.json
MEMWAL_CREDS_DIR=~/.memwal-wallearn

# Option B: Single JSON string (ideal for Railway, Docker, or CI/CD deployment)
# MEMWAL_CREDENTIALS_JSON=

# Option C: Discrete environment variables
MEMWAL_PRIVATE_KEY=your_hex_private_key
MEMWAL_ACCOUNT_ID=your_account_id
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
