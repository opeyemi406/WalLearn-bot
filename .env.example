# WalLearn Telegram Bot Environment
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=google/gemini-2.5-flash

# Walrus Protocol Mainnet Memory Configuration
# Option A: Directory containing credentials.json (local development)
MEMWAL_CREDS_DIR=~/.memwal-wallearn
# Option B: Raw JSON string for cloud/container deployment (Railway, Render, Fly.io)
# MEMWAL_CREDENTIALS_JSON={"accountId":"...","delegatePrivateKey":"..."}

WALRUS_ACCOUNT_ID=your_walrus_account_id_here
WALRUS_WALLET_ADDRESS=your_walrus_wallet_address_here
WALRUS_DELEGATE_ADDRESS=your_walrus_delegate_address_here
WALRUS_RELAYER_URL=https://relayer.memory.walrus.xyz
