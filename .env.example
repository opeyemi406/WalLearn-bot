# 1. Telegram Bot Configuration (Obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. AI Model Gateway (OpenRouter with Gemini 2.5 Flash)
OPENROUTER_API_KEY="your_openrouter_api_key_here"
AI_MODEL="google/gemini-2.5-flash"

# 3. Walrus Protocol Mainnet Memory Credentials
# Choose ONE of the following three methods:

# Method A (Local Development): Path to directory containing credentials.json
MEMWAL_CREDS_DIR="~/.memwal-wallearn"

# Method B (Cloud / Railway - Single JSON string from credentials.json):
# MEMWAL_CREDENTIALS_JSON='{"accountId":"0x...","delegatePrivateKey":"...","delegatePublicKeyHex":"...","walletAddress":"0x..."}'

# Method C (Cloud / Railway - Individual environment variables):
# WALRUS_DELEGATE_PRIVATE_KEY="your_ed25519_delegate_private_key"
WALRUS_ACCOUNT_ID="0x75a533d83e9fee09e36b29b14e8b093862042ee92b188e5122338da7118be140"
WALRUS_WALLET_ADDRESS="0xf3efc1f6d86ea33f736072668549138f00f2ca8fc67962019543e213a0fa2db2"
WALRUS_DELEGATE_ADDRESS="0x7dea8c54a7a72c231fa829abed50a47a03b7d1e99e74974bc21773c73490bbaa"
WALRUS_RELAYER_URL="https://relayer.memory.walrus.xyz"
